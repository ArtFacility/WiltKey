# =============================================================
#  SECRETS & RUNTIME DATA  —  never commit these
# =============================================================

# One-time-pad keystreams = raw cryptographic key material.
*.pad
keystream_*

# Local chat history / runtime state.
wiltkey_history.json

# Android release signing (none in repo yet — keep it that way).
**/key.properties
*.jks
*.keystore
# Machine-specific SDK paths (not secret, but don't commit).
**/local.properties

# Env / secret files.
.env
*.env
.env.*

# Internal working notes (stale; the real docs live on the website,
# and Before_Release.md contains deployment details). Un-ignore
# specific files here if you decide to publish them.
documentation/

# =============================================================
#  BUILD ARTIFACTS
# =============================================================

# Go relay binaries (build from source instead).
wiltkey_server/wiltkey-relay
*.exe

# Flutter / Dart.
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/ios/Flutter/ephemeral/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/.last_build_id

# =============================================================
#  LOGS / OS / EDITOR / TOOLING
# =============================================================
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.claude/

# Duplicate font sources kept outside the client (app uses wiltkey_client/assets/fonts/).
/assets/

# Personal release cheat-sheet (not for the repo).
/PLAY_RELEASE.md

# Relay release build artifacts (upload to GitHub Releases, not git)
wiltkey_server/dist/
wiltkey_server/linux_wiltkey_server

# Premium theme content is private (lives in a separate private repo cloned into
# this dir on the official build machine). Only the committed stub is public, so
# forks build with the free base themes and never receive premium theme source.
wiltkey_client/lib/core/theme/premium/*
!wiltkey_client/lib/core/theme/premium/premium_themes.dart

# Premium avatar-border code + SVG art is private (same private-repo model as
# premium themes). Only the committed stub + the free tinfoil border are public;
# the premium dirs keep just a .gitkeep so the asset path exists on every build.
wiltkey_client/lib/core/cosmetics/premium/*
!wiltkey_client/lib/core/cosmetics/premium/premium_borders.dart
wiltkey_client/assets/borders/premium/*
!wiltkey_client/assets/borders/premium/.gitkeep
