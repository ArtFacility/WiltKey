<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Play-flavor additions, merged into the main manifest. FCM wake-up push. -->

    <!-- Google Play Billing. The billing library merges this permission in on its
         own, but we declare it explicitly (Play flavor only) so the Play Console
         reliably detects it — the Console won't let you create in-app products or
         subscriptions until an uploaded build declares BILLING. The FOSS flavor
         never sees this (or the billing library), keeping FOSS Google-free. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- The Play build uses FCM, never the foreground-service socket, so the
         dataSync foreground-service permission (declared in the shared main
         manifest for the FOSS build) is unjustified here — strip it so Google
         Play doesn't require a foreground-service-type declaration for it.
         tools:node="remove" removes it no matter which manifest contributed it. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />

    <application>
        <!-- Receives the relay's data-only wake-up ping and posts a content-free
             notification (see WiltkeyFirebaseService). -->
        <service
            android:name=".WiltkeyFirebaseService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Fallbacks Firebase uses only if a message ever carried a notification
             payload (ours never do — they're data-only). Kept consistent with the
             app's status-bar icon and message channel regardless. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notif" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="wk_messages" />
    </application>
</manifest>
